# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://127.0.0.1

# Databasesd
DATABASE_URL=mongodb://localhost:27017/
DATABASE_NAME=devver

# Logto
LOGTO_SECRET=
LOGTO_CLIENT_ID=
LOGTO_BASE_URL=
LOGTO_WEBHOOK_SIGNING_KEY=

# Object storage (S3-compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=rustfsadmin123
STORAGE_BUCKET=devver
STORAGE_PUBLIC_URL=http://localhost:9000/devver
STORAGE_FORCE_PATH_STYLE=true

# Github
GITHUB_TOKEN=""
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=
# Cluster folder in the manifests repo (<org>-<env>); empty on the current prod
GITHUB_PATH_PREFIX=

# Deploy Agent
DEPLOY_AGENT_SECRET=
K8S_BASE_DOMAIN=
BACKEND_INTERNAL_URL=http://backend-service.devver-backend-service.svc.cluster.local:3000/api/v1
GIT_GATEWAY_SECRET=
GIT_SSH_HOST=

# Vault (KV v2; in-cluster login uses the service account, VAULT_TOKEN is for local dev)
VAULT_ADDR=https://vault.devver.app
VAULT_KV_MOUNT=kubernetes-cluster
VAULT_KV_PREFIX=<org>/<env>
VAULT_AUTH_MOUNT=k8s-<org>-<env>
VAULT_ROLE=backend
VAULT_TOKEN=

# ArgoCD
ARGOCD_BASE_URL=
ARGOCD_API_KEY=
