#!/bin/sh

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Skip validation for merge commits
if [ -n "$2" ]; then
  exit 0
fi

# List of allowed emojis and their codes
ALLOWED_EMOJIS="✨|🐛|📝|🎨|♻️|⚡|🔒|✅|🔧|🚀|🔥|💄|🏷️|📦|🚧|🧹"
ALLOWED_CODES=":sparkles:|:bug:|:memo:|:art:|:recycle:|:zap:|:lock:|:white_check_mark:|:wrench:|:rocket:|:fire:|:lipstick:|:label:|:package:|:construction:|:broom:"

# Check if commit message starts with an allowed emoji or code
if ! echo "$COMMIT_MSG" | grep -qE "^($ALLOWED_EMOJIS|$ALLOWED_CODES) "; then
  echo ""
  echo "❌ Commit message must start with an emoji or emoji code!"
  echo ""
  echo "Available emojis:"
  echo "  ✨ :sparkles:         New feature"
  echo "  🐛 :bug:              Bug fix"
  echo "  📝 :memo:             Documentation"
  echo "  🎨 :art:              Code improvement/structure"
  echo "  ♻️  :recycle:          Refactoring"
  echo "  ⚡ :zap:              Performance improvement"
  echo "  🔒 :lock:             Security"
  echo "  ✅ :white_check_mark:  Tests"
  echo "  🔧 :wrench:           Configuration"
  echo "  🚀 :rocket:           Deploy/CI/CD"
  echo "  🔥 :fire:             Remove code/files"
  echo "  💄 :lipstick:         UI/styling"
  echo "  🏷️  :label:            Types/interfaces"
  echo "  📦 :package:          Dependencies"
  echo "  🚧 :construction:     Work in progress"
  echo "  🧹 :broom:            Lint/Format fixes"
  echo ""
  echo "Example: ✨ Add JWT authentication"
  echo "Example: :sparkles: Add JWT authentication"
  echo ""
  exit 1
fi

exit 0
