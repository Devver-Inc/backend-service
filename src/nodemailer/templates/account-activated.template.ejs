<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>[MCR] Votre compte MyCotyRoom a été activé</title>
  </head>
  <body style="font-family: Lato-Regular, sans-serif">
    <table style="width: 100%; border: none">
      <tr>
        <td style="padding: 20px; border-collapse: collapse; border-spacing: 0">
          <table class="content" style="border-collapse: collapse; border: none; width: 600px; margin: auto">
            <!-- Header -->
            <tr>
              <td
                class="header"
                style="
                  background-color: #ff4d4d;
                  padding: 25px;
                  text-align: center;
                  margin: auto;
                  border-collapse: collapse;
                  border-spacing: 0;
                "
              >
                <img src="<%= logo %>" alt="logo" style="display: inline-block; width: 108px" />
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td
                class="body"
                style="
                  background-color: #ffffff;
                  padding: 60px 40px 30px;
                  text-align: left;
                  font-size: 14px;
                  font-weight: 500;
                  line-height: 1.6;
                  border-collapse: collapse;
                  border-spacing: 0;
                "
              >
                Bonjour <%= firstname %>,
                <br /><br />
                Vous venez de définir votre mot de passe.
                <br /><br />
                <span style="font-weight: 700">
                  Vous pouvez maintenant accéder à votre compte MyCotyRoom avec vos identifiants.
                </span>
              </td>
            </tr>

            <!-- Call to action Button -->
            <tr>
              <td
                style="
                  background-color: #ffffff;
                  padding: 0 40px 60px 40px;
                  text-align: center;
                  border-collapse: collapse;
                  border-spacing: 0;
                "
              >
                <!-- CTA Button -->
                <table style="margin: auto">
                  <tr>
                    <td
                      style="
                        background-color: #ff4d4d;
                        padding: 15px 20px;
                        border-radius: 5px;
                        border-collapse: collapse;
                        border-spacing: 0;
                        text-align: center;
                      "
                    >
                      <a
                        href="<%= url %>"
                        target="_blank"
                        style="color: #ffffff; text-decoration: none; font-size: 15px; font-weight: 700"
                        >Connexion</a
                      >
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <!-- Footer -->
            <tr>
              <td
                class="footer"
                style="
                  background-color: #ff4d4d;
                  padding: 25px;
                  text-align: center;
                  color: white;
                  font-size: 12px;
                  font-weight: 600;
                "
              >
                <a href="mailto:<%= contact %>" style="color: #ffffff; font-size: 12px; font-weight: 600"
                  ><%= contact %></a
                >
                <br />
                © Copyright © 2024 MCR, All Rights Reserved.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
